diff --git a/constants/event_constants.asm b/constants/event_constants.asm
index 7f4213f..bd5dc58 100644
--- a/constants/event_constants.asm
+++ b/constants/event_constants.asm
@@ -775,3 +775,13 @@ DEF INDIGO_PLATEAU_EVENTS_END EQU const_value - 1
 ; End of events
 	const_next $A00
 DEF NUM_EVENTS EQU const_value
+
+; Unused event flag (inside the const_skip 17 after EVENT_PALLET_AFTER_GETTING_POKEBALLS),
+; kept by the PROGRESS menu for its In-game HUD setting
+DEF PROGRESS_HUD_EVENT EQU 10
+; Unused event flag in the same gap: set by the PROGRESS menu once the POTION a new game puts in
+; the PC has been taken out
+DEF PROGRESS_PC_POTION_EVENT EQU 11
+; Unused event flag in the same gap: set by the PROGRESS menu when the game designer shows the
+; diploma (the game keeps no record of it)
+DEF PROGRESS_DIPLOMA_EVENT EQU 12
diff --git a/engine/events/diploma.asm b/engine/events/diploma.asm
