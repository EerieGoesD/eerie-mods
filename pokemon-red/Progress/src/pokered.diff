 	xor a
@@ -115,3 +115,13 @@ DiplomaCongrats:
 
 DiplomaGameFreak:
 	db "GAME FREAK@"
+
+; in the bank's free space so nothing above moves
+PUSHS
+SECTION "Diploma Progress", ROMX, BANK[$15]
+
+DisplayDiplomaMarkProgress:
