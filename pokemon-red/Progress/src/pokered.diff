diff --git a/home/progress_hud.asm b/home/progress_hud.asm
new file mode 100644
index 0000000..c78d68c
--- /dev/null
+++ b/home/progress_hud.asm
@@ -0,0 +1,13 @@
+; Each frame the player stands on the map: the PROGRESS warning for a newly entered map, or
+; the next objective on SELECT (In-game HUD set to YES). Both live in ProgressOverworld.
+; Reached by a jump from OverworldLoopLessDelay.startButtonNotPressed, with a = buttons.
+ProgressSelectHook::
+	ld b, a
+	push bc
+	farcall ProgressOverworld
+	pop bc
+	jp c, OverworldLoop ; a box was shown
+	ld a, b
+	bit B_PAD_A, a
+	jp z, OverworldLoopLessDelay.checkIfDownButtonIsPressed
+	jp OverworldLoopLessDelay.aButtonPressed
