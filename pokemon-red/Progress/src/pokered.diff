+ProgressGetCategory:
+; a = category; returns hl = first entry, bc = entry count, de = name
+	ld l, a
+	ld h, 0
+	add hl, hl
+	add hl, hl
+	add hl, hl
+	ld bc, ProgressCategories
+	add hl, bc
+	ld a, [hli]
+	ld e, a
+	ld a, [hli]
+	ld d, a
+	ld a, [hli]
+	ld c, a
+	ld a, [hli]
+	ld b, a
+	ld a, [hli]
+	ld h, [hl]
+	ld l, a
+	push hl
+	ld h, b
+	ld l, c
+	pop bc
+	ret
+
+ProgressGetHeading:
+; de = the heading shown after "NEXT:" for list [wProgNextCat]. hl is kept.
+	push hl
+	ld a, [wProgNextCat]
+	ld l, a
+	ld h, 0
+	add hl, hl
+	add hl, hl
+	add hl, hl
+	ld bc, ProgressCategories + 6
+	add hl, bc
+	ld a, [hli]
+	ld e, a
+	ld d, [hl]
+	pop hl
+	ret
+
+ProgressNextEntry:
+; hl = the entry after hl
+	ld a, [hl]
+	ld bc, 9
+	bit 7, a
+	jr z, .add
+	ld c, 12
+.add
+	add hl, bc
+	ret
+
+ProgressEntryGate:
+; hl = entry; returns d = its gate (milestone), e = its place in travel order. hl is kept.
+	push hl
+	ld a, [hl]
+	ld bc, 3
+	bit 7, a
+	jr z, .one
+	ld c, 6
+.one
+	add hl, bc
+	ld d, [hl]
+	inc hl
+	ld e, [hl]
+	pop hl
+	ret
+
+ProgressEntryStrings:
+; hl = entry; returns de = first line, bc = second line. hl is kept.
+	push hl
+	ld a, [hl]
+	ld bc, 5
+	bit 7, a
+	jr z, .one
+	ld c, 8
+.one
+	add hl, bc
+	ld a, [hli]
+	ld e, a
+	ld a, [hli]
+	ld d, a
+	ld a, [hli]
+	ld c, a
+	ld b, [hl]
+	pop hl
+	ret
+
+ProgressEntryDone:
+; hl = entry or milestone; carry if its checks pass. hl is kept.
+	push hl
+	ld a, [hli]
+	ld b, a
+	ld e, [hl]
+	inc hl
+	ld d, [hl]
+	inc hl
+	push hl
+	push bc
+	and PROG_CHECK_MASK
+	call ProgressCheck
+	pop bc
+	pop hl
+	jr z, .firstFails
+	bit 7, b
+	jr z, .done
+	bit 6, b
+	jr z, .done
+	jr .second
+.firstFails
+	bit 7, b
+	jr z, .notDone
+	bit 6, b
+	jr nz, .notDone
+.second
+	ld a, [hli]
+	and PROG_CHECK_MASK
+	ld e, [hl]
+	inc hl
+	ld d, [hl]
+	call ProgressCheck
+	jr z, .notDone
+.done
+	pop hl
+	scf
+	ret
+.notDone
+	pop hl
+	and a
+	ret
+
+ProgressCheck:
+; a = check kind (with PROG_INVERT), de = argument; nz if it passes. hl is kept.
+	bit 5, a
+	jr nz, .inverted
+	and PROG_KIND_MASK
+	jr ProgressTestKind
+.inverted
+	and PROG_KIND_MASK
+	call ProgressTestKind
+	jr z, .pass
+	xor a
+	ret
+.pass
+	or 1
+	ret
+
+ProgressTestKind:
+; a = kind, de = argument; nz if it passes. hl is kept.
+	cp PROG_MILESTONE
+	jr z, .milestone
+	cp PROG_ALWAYS
+	jr z, .always
+	cp PROG_OWNCOUNT
+	jr z, .owncount
+	push hl
+	add a
+	ld c, a
+	ld b, 0
+	ld hl, ProgressKindBases
+	add hl, bc
+	ld a, [hli]
+	ld h, [hl]
+	ld l, a
+	ld a, e
+	and 7
+	ld c, a
+	srl d
+	rr e
+	srl d
+	rr e
+	srl d
+	rr e
+	add hl, de
+	ld a, [hl]
+	inc c
+.shift
+	dec c
+	jr z, .test
+	rrca
+	jr .shift
+.test
+	and 1
+	pop hl
+	ret
+.always
+	or 1
+	ret
+.milestone
+	ld a, e
+	jr ProgressMilestoneDone
+.owncount
+	push hl
+	push de
+	ld hl, wPokedexOwned
+	ld b, wPokedexOwnedEnd - wPokedexOwned
+	call CountSetBits
+	pop de
+	pop hl
+	ld a, [wNumSetBits]
+	cp e
+	jr c, .fail
+	or 1
+	ret
+.fail
+	xor a
+	ret
+
+ProgressMilestoneDone:
+; a = milestone; nz if it has happened. hl is kept.
+	push hl
+	ld l, a
+	ld h, 0
+	ld b, h
+	ld c, l
+	add hl, hl
+	add hl, bc
+	add hl, hl ; x6
+	ld bc, ProgressMilestones
+	add hl, bc
+	call ProgressEntryDone
+	pop hl
+	jr c, .yes
+	xor a
+	ret
+.yes
+	or 1
+	ret
+
+ProgressKindBases:
+	dw wEventFlags                ; PROG_EVENT
+	dw wToggleableObjectFlags     ; PROG_TOGGLE
+	dw wObtainedHiddenItemsFlags  ; PROG_HIDDEN
+	dw wCompletedInGameTradeFlags ; PROG_TRADE
+	dw wPokedexOwned              ; PROG_DEX
+	dw wStatusFlags1              ; PROG_FLAGS1
+	dw wStatusFlags4              ; PROG_FLAGS4
+	dw wObtainedHiddenCoinsFlags  ; PROG_HIDDENCOIN
+	dw wSSAnne2FCurScript         ; PROG_SSANNE2F (SCRIPT_SSANNE2F_NOOP is 4)
+	dw wTownVisitedFlag           ; PROG_TOWN
+
+ProgressFindNext:
+; hl = the next thing to do: of everything not done whose gate has happened, the one with the
+; earliest gate, then the earliest place. [wProgNextCat] = its list. Carry if nothing is left.
+	ld a, $ff
+	ld [wProgBestGate], a
+	ld [wProgBestOrder], a
+	xor a
+	ld [wProgBestPtr + 1], a
+	ld a, 1 ; the story list goes last, so a step and an item at the same place show the item first
+.catLoop
+	ld [wProgScanCat], a
+	call ProgressGetCategory
+.entryLoop
+	ld a, b
+	or c
+	jr z, .nextCat
+	push bc
+	call ProgressEntryDone
+	jr c, .next
+	call ProgressEntryGate
+	ld a, [wProgBestGate]
+	cp d
+	jr c, .next
+	jr nz, .candidate
+	ld a, [wProgBestOrder]
+	cp e
+	jr c, .next
+	jr z, .next
+.candidate
+	push de
+	ld a, d
+	call ProgressMilestoneDone
+	pop de
+	jr z, .next
+	ld a, d
+	ld [wProgBestGate], a
+	ld a, e
+	ld [wProgBestOrder], a
+	ld a, l
+	ld [wProgBestPtr], a
+	ld a, h
+	ld [wProgBestPtr + 1], a
+	ld a, [wProgScanCat]
+	ld [wProgNextCat], a
+.next
+	call ProgressNextEntry
+	pop bc
+	dec bc
+	jr .entryLoop
+.nextCat
+	ld a, [wProgScanCat]
+	and a
+	jr z, .done
+	inc a
+	cp NUM_PROGRESS_CATEGORIES
+	jr c, .catLoop
+	xor a
+	jr .catLoop
+.done
+	ld a, [wProgBestPtr]
+	ld l, a
+	ld a, [wProgBestPtr + 1]
+	ld h, a
+	and a
+	scf
+	ret z
+	and a
+	ret
+
+ProgressCount:
+; a = category; wProgDone and wProgTotal = its done and total counts
+	call ProgressGetCategory
+	ld a, c
+	ld [wProgTotal], a
+	ld a, b
+	ld [wProgTotal + 1], a
+	xor a
+	ld [wProgDone], a
+	ld [wProgDone + 1], a
+.loop
+	ld a, b
+	or c
+	ret z
+	push bc
+	call ProgressEntryDone
+	jr nc, .next
+	ld a, [wProgDone]
+	add 1
+	ld [wProgDone], a
+	ld a, [wProgDone + 1]
+	adc 0
+	ld [wProgDone + 1], a
+.next
+	call ProgressNextEntry
+	pop bc
+	dec bc
+	jr .loop
+
+ProgressFindRemaining:
+; a = category, de = how many not-done entries to skip
+; returns hl = entry, bc = entries from it to the end of the list; carry if none
+	push de
+	call ProgressGetCategory
+	pop de
+.loop
+	ld a, b
+	or c
+	jr z, .none
+	push bc
+	push de
+	call ProgressEntryDone
+	pop de
+	pop bc
+	jr c, .skip
+	ld a, d
+	or e
+	ret z ; or clears carry
+	dec de
+.skip
+	push bc
+	call ProgressNextEntry
+	pop bc
+	dec bc
+	jr .loop
+.none
+	scf
+	ret
+
+ProgressNextRemaining:
+; hl = entry, bc = entries from it to the end; moves to the next not-done entry, carry if none
+.advance
+	push bc
+	call ProgressNextEntry
+	pop bc
+	dec bc
+	ld a, b
+	or c
+	jr z, .none
+	push bc
+	call ProgressEntryDone
+	pop bc
+	jr c, .advance
+	ret
+.none
+	scf
+	ret
+
+ProgressPercent:
+; a = wProgDone * 100 / wProgTotal
+	ld a, [wProgDone]
+	ld l, a
+	ld a, [wProgDone + 1]
+	ld h, a
+	ld a, [wProgTotal]
+	ld e, a
+	ld a, [wProgTotal + 1]
+	ld d, a
+	; fallthrough
+
+ProgressPercentHLDE:
+; a = hl * 100 / de, rounded down
+	ld a, d
+	or e
+	jr nz, .scale
+	ld a, 100
+	ret
+.scale
+; keep hl * 100 inside 16 bits
+	ld a, d
+	cp HIGH(656)
+	jr c, .ok
+	jr nz, .halve
+	ld a, e
+	cp LOW(656)
+	jr c, .ok
+.halve
+	srl d
+	rr e
+	srl h
+	rr l
+	jr .scale
+.ok
+	push de
+	add hl, hl
+	add hl, hl
+	push hl ; x4
+	add hl, hl
+	add hl, hl
+	add hl, hl
+	ld b, h
+	ld c, l ; x32
+	add hl, hl ; x64
+	add hl, bc ; x96
+	pop bc
+	add hl, bc ; x100
+	pop de
+	ld b, 0
+.div
+	ld a, l
+	sub e
+	ld l, a
+	ld a, h
+	sbc d
+	ld h, a
+	jr c, .done
+	inc b
+	jr .div
+.done
+	ld a, b
+	ret
+
+ProgressPrintDoneTotal:
+; at hl: done (3 digits), "/", total (3 digits)
+	push hl
+	ld a, [wProgDone + 1]
+	ld [wProgPrint], a
+	ld a, [wProgDone]
+	ld [wProgPrint + 1], a
+	ld de, wProgPrint
+	lb bc, 2, 3
+	call PrintNumber
+	ld [hl], '/'
+	inc hl
+	ld a, [wProgTotal + 1]
+	ld [wProgPrint], a
+	ld a, [wProgTotal]
+	ld [wProgPrint + 1], a
+	ld de, wProgPrint
+	lb bc, 2, 3
+	call PrintNumber
+	pop hl
+	ret
+
+ProgressPrintPct:
+; at hl: a as 3 digits, then "%"
+	ld [wProgPrint], a
+	ld de, wProgPrint
+	lb bc, 1, 3
+	call PrintNumber
+	ld [hl], PROG_PERCENT
+	ret
