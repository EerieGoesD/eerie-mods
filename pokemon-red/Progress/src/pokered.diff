diff --git a/engine/menus/progress.asm b/engine/menus/progress.asm
new file mode 100644
index 0000000..4a9e7fd
--- /dev/null
+++ b/engine/menus/progress.asm
@@ -0,0 +1,1181 @@
+; PROGRESS start menu option: what is left to do for 100%, and the next step towards it.
+; Every check reads flags the game already keeps. The only new saved setting, In-game HUD,
+; uses an event flag the game never touches (PROGRESS_HUD_EVENT).
+
+; check kinds (the low 5 bits of a check byte)
+DEF PROG_EVENT     EQU 0
+DEF PROG_TOGGLE    EQU 1
+DEF PROG_HIDDEN    EQU 2
+DEF PROG_TRADE     EQU 3
+DEF PROG_DEX       EQU 4
+DEF PROG_FLAGS1    EQU 5
+DEF PROG_FLAGS4    EQU 6
+DEF PROG_HIDDENCOIN EQU 7
+DEF PROG_SSANNE2F  EQU 8 ; S.S. Anne 2F map script: bit 2 is only set once the rival battle is over
+DEF PROG_TOWN      EQU 9 ; argument: town map id
+DEF PROG_MILESTONE EQU 10 ; argument: milestone number
+DEF PROG_ALWAYS    EQU 11
+DEF PROG_OWNCOUNT  EQU 12 ; argument: how many Pokemon must be owned
+DEF PROG_INVERT    EQU %00100000 ; the check passes when the flag is NOT set
+DEF PROG_EITHER    EQU %10000000 ; a second check follows, either one counts
+DEF PROG_BOTH      EQU %11000000 ; a second check follows, both are needed
+DEF PROG_KIND_MASK  EQU %00011111
+DEF PROG_CHECK_MASK EQU %00111111
+
+DEF PROG_FIRST_ROW EQU 6  ; summary: row of the first category
+DEF PROG_HUD_ROW   EQU PROG_FIRST_ROW + 9 ; under the last list (checked at the end)
+DEF PROG_LIST_TOP  EQU 2  ; list: row of the first entry
+DEF PROG_PAGE      EQU 8  ; list: entries per screen
+DEF PROG_PERCENT   EQU $f0 ; font slot borrowed for "%" while the screen is open
+
+ProgressMenu::
+	ld de, ProgressPercentGlyph
+	ld hl, vFont tile (PROG_PERCENT - $80)
+	lb bc, BANK(ProgressPercentGlyph), 1
+	call CopyVideoDataDouble
+	ldh a, [hJoy6]
+	push af
+	ldh a, [hJoy7]
+	push af
+	ld a, 1 ; repeat held directions, never A or B
+	ldh [hJoy7], a
+	xor a
+	ldh [hJoy6], a
+	ld [wProgCursor], a
+.redraw
+	call ProgressDrawSummary
+.loop
+	call ProgressGetInput
+	bit B_PAD_B, a
+	jr nz, .exit
+	bit B_PAD_START, a
+	jr nz, .exit
+	bit B_PAD_A, a
+	jr nz, .open
+	bit B_PAD_UP, a
+	jr nz, .up
+	bit B_PAD_DOWN, a
+	jr z, .loop
+	ld a, [wProgCursor]
+	inc a
+	cp NUM_PROGRESS_CATEGORIES + 1
+	jr c, .move
+	xor a
+	jr .move
+.up
+	ld a, [wProgCursor]
+	and a
+	jr nz, .dec
+	ld a, NUM_PROGRESS_CATEGORIES + 1
+.dec
+	dec a
+.move
+	push af
+	call ProgressCursorAddr
+	ld [hl], ' '
+	pop af
+	ld [wProgCursor], a
+	call ProgressCursorAddr
+	ld [hl], '▶'
+	jr .loop
+.open
+	ld a, SFX_PRESS_AB
+	call PlaySound
+	ld a, [wProgCursor]
+	cp NUM_PROGRESS_CATEGORIES
+	jr z, .toggleHud
+	ld [wProgCat], a
+	call ProgressList
+	jr .redraw
+.toggleHud
+	ld hl, wEventFlags + PROGRESS_HUD_EVENT / 8
+	ld a, [hl]
+	xor 1 << (PROGRESS_HUD_EVENT % 8)
+	ld [hl], a
+	call ProgressPrintHud
+	jr .loop
+.exit
+	ld a, SFX_PRESS_AB
+	call PlaySound
+	pop af
+	ldh [hJoy7], a
+	pop af
+	ldh [hJoy6], a
+	ld de, FontGraphics + (PROG_PERCENT - $80) * TILE_1BPP_SIZE
+	ld hl, vFont tile (PROG_PERCENT - $80)
+	lb bc, BANK(FontGraphics), 1
+	jp CopyVideoDataDouble
+
+ProgressOverworld::
+; Called each frame the player stands still on the map. Carry if a box was shown.
+	call ProgressCheckPcPotion
+	ld a, [wStatusFlags5]
+	bit BIT_SCRIPTED_MOVEMENT_STATE, a
+	jr nz, .no
+	ld a, [wJoyIgnore]
+	and a
+	jr nz, .no ; a map script has the controls; look again once it is done
+	ld a, [wCurMap]
+	ld hl, wProgLastMap
+	cp [hl]
+	jr z, .select
+	ld [hl], a
+	call ProgressFindWarning
+	jr nc, .select
+	ld a, l
+	ld [wProgBestPtr], a
+	ld a, h
+	ld [wProgBestPtr + 1], a
+	call ProgressShowWarning
+	scf
+	ret
+.select
+	ldh a, [hJoyPressed]
+	bit B_PAD_SELECT, a
+	jr z, .no
+	ld a, [wEventFlags + PROGRESS_HUD_EVENT / 8]
+	bit PROGRESS_HUD_EVENT % 8, a
+	jr z, .no
+	call ProgressShowHud
+	scf
+	ret
+.no
+	and a
+	ret
+
+ProgressCheckPcPotion:
+; The game keeps no record of the POTION a new game puts in the PC, so mark it taken as soon
+; as the PC holds no POTION
+	ld a, [wEventFlags + PROGRESS_PC_POTION_EVENT / 8]
+	bit PROGRESS_PC_POTION_EVENT % 8, a
+	ret nz
+	ld hl, wBoxItems
+.loop
+	ld a, [hli]
+	cp -1
+	jr z, .taken
+	cp POTION
+	ret z
+	inc hl
+	jr .loop
+.taken
+	ld hl, wEventFlags + PROGRESS_PC_POTION_EVENT / 8
+	set PROGRESS_PC_POTION_EVENT % 8, [hl]
+	ret
+
+; the same steps as DisplayTextID, with a PROGRESS box in place of a map text
+ProgressShowHud:
+	ldh a, [hLoadedROMBank]
+	push af
+	ld a, 1 ; not the start menu, so the standard box is set up
+	ldh [hTextID], a
+	farcall DisplayTextIDInit
+	call ProgressHud
+	jp CloseTextDisplay
+
+ProgressShowWarning:
+	ldh a, [hLoadedROMBank]
+	push af
+	ld a, 1
+	ldh [hTextID], a
+	farcall DisplayTextIDInit
+	call ProgressWarnBox
+	jp CloseTextDisplay
+
+ProgressHud:
+; SELECT on the map: the next objective in a box at the bottom, until a button is pressed
+	hlcoord 0, 10
+	lb bc, 6, 18
+	call TextBoxBorder
+	ld a, 12
+	ld c, 2
+	call ProgressDrawNext
+	; fallthrough
+
+ProgressWaitButton:
+	call DelayFrame
+	call Joypad
+	ldh a, [hJoyPressed]
+	and PAD_A | PAD_B | PAD_START | PAD_SELECT
+	jr z, ProgressWaitButton
+	ret
+
+ProgressWarnBox:
+; the warning at [wProgBestPtr]; [wProgPct] = how many of its things are not done ($ff: no list)
+	hlcoord 0, 10
+	lb bc, 6, 18
+	call TextBoxBorder
+	hlcoord 1, 11
+	ld de, ProgressWarningText
+	call PlaceString
+	ld a, [wProgBestPtr]
+	ld l, a
+	ld a, [wProgBestPtr + 1]
+	ld h, a
+	inc hl
+	inc hl
+	ld a, 12
+.lines
+	push af
+	cp 15
+	jr nz, .row
+	ld a, 16 ; the fourth line goes under the count
+.row
+	push hl
+	call ProgressRowAddr
+	ld d, h
+	ld e, l
+	pop hl
+	ld a, [hli]
+	ld c, a
+	ld a, [hli]
+	ld b, a
+	push hl
+	ld h, d
+	ld l, e
+	ld d, b
+	ld e, c
+	call ProgressPlaceString
+	pop hl
+	pop af
+	inc a
+	cp 16
+	jr c, .lines
+	ld a, [wProgPct]
+	cp $ff
+	jr z, .wait
+	hlcoord 1, 15
+	ld de, ProgressNotDoneText
+	call PlaceString
+	ld a, [wProgPct]
+	ld [wProgPrint], a
+	hlcoord 15, 15
+	ld de, wProgPrint
+	lb bc, 1, 3
+	call PrintNumber
+.wait
+	jr ProgressWaitButton
+
+ProgressFindWarning:
+; a warning for the map the player is on whose condition holds and that still has something
+; to lose: hl = its record, [wProgPct] = how many are not done ($ff: no list); carry if found
+	ld hl, ProgressWarnings
+.loop
+	ld a, [hl]
+	cp $ff
+	jr z, .none
+	ld b, a
+	ld a, [wCurMap]
+	cp b
+	jr nz, .next
+	push hl
+	inc hl
+	ld a, [hl]
+	call ProgressMilestoneDone
+	pop hl
+	jr z, .next
+	push hl
+	call ProgressWarnCount
+	pop hl
+	and a
+	jr z, .next
+	ld [wProgPct], a
+	scf
+	ret
+.next
+	ld bc, 12
+	add hl, bc
+	jr .loop
+.none
+	and a
+	ret
+
+ProgressWarnCount:
+; hl = warning; a = how many entries in its list are not done ($ff if it has no list)
+	ld bc, 10
+	add hl, bc
+	ld a, [hli]
+	ld h, [hl]
+	ld l, a
+	or h
+	jr nz, .list
+	ld a, $ff
+	ret
+.list
+	xor a
+	ld [wProgRow], a
+.loop
+	ld a, [hli]
+	ld e, a
+	ld a, [hli]
+	ld d, a
+	or e
+	jr z, .end
+	push hl
+	ld h, d
+	ld l, e
+	call ProgressEntryDone
+	pop hl
+	jr c, .loop
+	ld a, [wProgRow]
+	inc a
+	ld [wProgRow], a
+	jr .loop
+.end
+	ld a, [wProgRow]
+	ret
+
+ProgressDrawNext:
+; "NEXT: <list>" on row a, then the step's two lines c rows apart, from column 1
+	ld [wProgRow], a
+	ld a, c
+	ld [wProgPct], a
+	ld a, [wProgRow]
+	call ProgressRowAddr
+	ld de, ProgressNextText
+	call PlaceString
+	call ProgressFindNext
+	jr nc, .found
+	call ProgressNextLine
+	ld de, ProgressAllDoneText
+	jp PlaceString
+.found
+	push hl
+	ld a, [wProgRow]
+	call ProgressRowAddr
+	ld bc, 6
+	add hl, bc
+	call ProgressGetHeading
+	call PlaceString
+	pop hl
+	call ProgressEntryStrings
+	push bc
+	call ProgressNextLine
+	call ProgressPlaceString
+	pop de
+	call ProgressNextLine
+	jp ProgressPlaceString
+
+ProgressNextLine:
+; hl = column 1 of the next line (wProgRow += wProgPct). de is kept.
+	ld a, [wProgPct]
+	ld b, a
+	ld a, [wProgRow]
+	add b
+	ld [wProgRow], a
+	push de
+	call ProgressRowAddr
+	pop de
+	ret
+
+ProgressPlaceString:
+; PlaceString for de in the strings bank: copied to wNameBuffer first
+	push hl
+	ld h, d
+	ld l, e
+	ld de, wNameBuffer
+	ld bc, NAME_BUFFER_LENGTH
+	ld a, BANK(ProgStr0)
+	call FarCopyData
+	pop hl
+	ld de, wNameBuffer
+	jp PlaceString
+
+ProgressGetInput:
+; wait for a button, return it in a
+	call DelayFrame
+	call JoypadLowSensitivity
+	ldh a, [hJoyFiltered]
+	and a
+	jr z, ProgressGetInput
+	ret
+
+ProgressCursorAddr:
+; hl = summary cursor position
+	ld a, [wProgCursor]
+	add PROG_FIRST_ROW
+	; fallthrough
+
+ProgressRowAddr:
+; hl = column 1 of row a
+	hlcoord 1, 0
+	ld bc, SCREEN_WIDTH
+	jp AddNTimes
+
+ProgressPrintHud:
+	hlcoord 15, PROG_HUD_ROW
+	ld de, ProgressNoText
+	ld a, [wEventFlags + PROGRESS_HUD_EVENT / 8]
+	bit PROGRESS_HUD_EVENT % 8, a
+	jr z, .print
+	ld de, ProgressYesText
+.print
+	jp PlaceString
+
+ProgressDrawSummary:
+	xor a
+	ldh [hAutoBGTransferEnabled], a
+	call ClearScreen
+	hlcoord 0, 0
+	lb bc, 16, 18
+	call TextBoxBorder
+	hlcoord 1, 1
+	ld de, ProgressTitleText
+	call PlaceString
+	hlcoord 2, 16
+	ld de, ProgressHintText
+	call PlaceString
+	hlcoord 2, PROG_HUD_ROW
+	ld de, ProgressHudText
+	call PlaceString
+	call ProgressPrintHud
+	ld a, 2
+	ld c, 1
+	call ProgressDrawNext
+	xor a
+	ld hl, wProgSumDone
+	ld [hli], a
+	ld [hli], a
+	ld [hli], a ; wProgSumTotal
+	ld [hl], a
+	ld [wProgCat], a
+.catLoop
+	ld a, [wProgCat]
+	call ProgressCount
+	ld hl, wProgSumDone
+	ld a, [wProgDone]
+	add [hl]
+	ld [hli], a
+	ld a, [wProgDone + 1]
+	adc [hl]
+	ld [hli], a
+	ld a, [wProgTotal] ; hl = wProgSumTotal
+	add [hl]
+	ld [hli], a
+	ld a, [wProgTotal + 1]
+	adc [hl]
+	ld [hl], a
+	ld a, [wProgCat]
+	call ProgressGetCategory
+	push de
+	ld a, [wProgCat]
+	add PROG_FIRST_ROW
+	call ProgressRowAddr
+	inc hl
+	pop de
+	push hl
+	call PlaceString
+	pop hl
+	ld bc, 9
+	add hl, bc
+	call ProgressPrintDoneTotal
+	ld a, [wProgCat]
+	inc a
+	ld [wProgCat], a
+	cp NUM_PROGRESS_CATEGORIES
+	jr c, .catLoop
+; overall percentage
+	ld a, [wProgSumDone]
+	ld l, a
+	ld a, [wProgSumDone + 1]
+	ld h, a
+	ld a, [wProgSumTotal]
+	ld e, a
+	ld a, [wProgSumTotal + 1]
+	ld d, a
+	call ProgressPercentHLDE
+	hlcoord 14, 1
+	call ProgressPrintPct
+	call ProgressCursorAddr
+	ld [hl], '▶'
+	ld a, 1
+	ldh [hAutoBGTransferEnabled], a
+	jp Delay3
+
+ProgressList:
+	xor a
+	ld [wProgScroll], a
+	ld [wProgScroll + 1], a
+.redraw
+	call ProgressDrawList
+.loop
+	call ProgressGetInput
+	bit B_PAD_B, a
+	jr nz, .exit
+	bit B_PAD_START, a
+	jr nz, .exit
+	ld de, 1
+	bit B_PAD_DOWN, a
+	jr nz, .down
+	bit B_PAD_UP, a
+	jr nz, .up
+	ld de, PROG_PAGE
+	bit B_PAD_RIGHT, a
+	jr nz, .down
+	bit B_PAD_LEFT, a
+	jr z, .loop
+.up
+	call ProgressScrollUp
+	jr c, .loop
+	jr .redraw
+.down
+	call ProgressScrollDown
+	jr c, .loop
+	jr .redraw
+.exit
+	ld a, SFX_PRESS_AB
+	jp PlaySound
+
+ProgressDrawList:
+	xor a
+	ldh [hAutoBGTransferEnabled], a
+	call ClearScreen
+	ld a, [wProgCat]
+	call ProgressGetCategory
+	hlcoord 1, 0
+	call PlaceString
+	ld a, [wProgCat]
+	call ProgressCount
+	ld hl, wProgDone
+	ld a, [wProgTotal]
+	sub [hl]
+	ld [wProgLeft], a
+	inc hl
+	ld a, [wProgTotal + 1]
+	sbc [hl]
+	ld [wProgLeft + 1], a
+	hlcoord 12, 0
+	call ProgressPrintDoneTotal
+	call ProgressPercent
+	ld [wProgPct], a
+	hlcoord 1, 1
+	ld de, ProgressDoneText
+	call PlaceString
+	ld a, [wProgPct]
+	hlcoord 6, 1
+	call ProgressPrintPct
+	hlcoord 11, 1
+	ld de, ProgressLeftText
+	call PlaceString
+	ld a, [wProgPct]
+	ld b, a
+	ld a, 100
+	sub b
+	hlcoord 16, 1
+	call ProgressPrintPct
+	ld a, [wProgScroll]
+	ld e, a
+	ld a, [wProgScroll + 1]
+	ld d, a
+	ld a, [wProgCat]
+	call ProgressFindRemaining
+	jr nc, .entries
+	hlcoord 1, 3
+	ld de, ProgressAllDoneText
+	call PlaceString
+	jr .show
+.entries
+	ld a, PROG_LIST_TOP
+	ld [wProgRow], a
+.entryLoop
+	push hl
+	push bc
+	call ProgressEntryStrings
+	push bc
+	ld a, [wProgRow]
+	call ProgressRowAddr
+	call ProgressPlaceString
+	ld a, [wProgRow]
+	inc a
+	call ProgressRowAddr
+	inc hl
+	pop de
+	call ProgressPlaceString
+	pop bc
+	pop hl
+	ld a, [wProgRow]
+	add 2
+	ld [wProgRow], a
+	call ProgressNextRemaining
+	jr c, .show
+	ld a, [wProgRow]
+	cp PROG_LIST_TOP + PROG_PAGE * 2
+	jr c, .entryLoop
+	ld a, '▼'
+	ldcoord_a 0, 17
+.show
+	ld a, 1
+	ldh [hAutoBGTransferEnabled], a
+	jp Delay3
+
+ProgressMaxScroll:
+; hl = how far the list can scroll (entries left minus one screen, at least 0)
+	ld a, [wProgLeft]
+	ld l, a
+	ld a, [wProgLeft + 1]
+	ld h, a
+	ld de, -PROG_PAGE
+	add hl, de
+	ret c
+	ld hl, 0
+	ret
+
+ProgressScrollDown:
+; scroll down by de entries; carry if nothing changed
+	ld a, [wProgScroll]
+	ld l, a
+	ld a, [wProgScroll + 1]
+	ld h, a
+	add hl, de
+	push hl
+	call ProgressMaxScroll
+	pop de
+	ld a, l
+	sub e
+	ld a, h
+	sbc d
+	jr nc, ProgressSetScroll
+	ld d, h
+	ld e, l
+	; fallthrough
+
+ProgressSetScroll:
+; scroll = de; carry if it was already that
+	ld a, [wProgScroll]
+	cp e
+	jr nz, .set
+	ld a, [wProgScroll + 1]
+	cp d
+	jr nz, .set
+	scf
+	ret
+.set
+	ld a, e
+	ld [wProgScroll], a
+	ld a, d
+	ld [wProgScroll + 1], a
+	and a
+	ret
+
+ProgressScrollUp:
+; scroll up by de entries; carry if nothing changed
+	ld a, [wProgScroll]
+	sub e
+	ld e, a
+	ld a, [wProgScroll + 1]
+	sbc d
+	ld d, a
+	jr nc, ProgressSetScroll
+	ld de, 0
+	jr ProgressSetScroll
